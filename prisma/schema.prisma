generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String   @unique
  name        String
  password    String?
  role        String   @default("CLIENT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts  Account[]
  campaigns Campaign[]
}

model Account {
  id            String   @id @default(cuid())
  userId        String
  email         String   @unique
  passwordMail  String
  username      String   @unique
  passwordX     String
  storagePath   String
  cookiesExpire DateTime?
  status        String   @default("CREATING")
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime?
  tweetCount    Int      @default(0)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignLogs CampaignLog[]
}

model Campaign {
  id            String   @id @default(cuid())
  userId        String
  urls          String
  comments      String
  browsersCount Int
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  finishedAt    DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignLogs CampaignLog[]
}

model CampaignLog {
  id           String   @id @default(cuid())
  campaignId   String
  accountId    String
  url          String
  round        Int
  action       String
  success      Boolean
  errorMessage String?
  durationMs   Int?
  createdAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}
